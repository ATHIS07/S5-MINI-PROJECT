# ==============================================================================
# CloudPulse Environment Variables
# ==============================================================================

# Backend API Base URL (AWS API Gateway stage or custom backend)
CLOUDPULSE_API_BASE_URL=https://zpbpv26plb.execute-api.ap-south-1.amazonaws.com/prod

# Authentication mode: none | bearer | cognito | apikey
CLOUDPULSE_AUTH_MODE=none

# Public API Key (Optional: only if required by API Gateway usage plan)
CLOUDPULSE_API_KEY=

# Amazon Cognito Configuration
CLOUDPULSE_COGNITO_USER_POOL_ID=
CLOUDPULSE_COGNITO_CLIENT_ID=
CLOUDPULSE_COGNITO_REGION=ap-south-1

# Development Server Port
PORT=8000
